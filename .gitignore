# Сборка и генерация SvelteKit. Prettier берёт игнор только из корневого .gitignore
# (вложенные не читает), поэтому они указаны здесь, а не только в apps/web/.gitignore
**/.svelte-kit
apps/*/build

# Prisma
packages/db/src/generated

# VS Code: настройки проекта — только в корне, вложенные .vscode не коммитятся
.vscode/
!/.vscode/
