# Postgres из docker compose. Если порт 5432 занят локальным Postgres — поменяйте
# POSTGRES_PORT и порт в DATABASE_URL.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://tgab:tgab@localhost:5432/tgab

# Redis — пока не используется (понадобится воркеру напоминаний)
REDIS_URL=redis://localhost:6379

# Токен бота от BotFather (для разработки — отдельный dev-бот).
# Нужен боту и web-серверу (проверка подписи initData Mini App).
BOT_TOKEN=

# HTTPS-адрес Mini App (в разработке — адрес туннеля). Кнопка в /start бота.
MINI_APP_URL=

# telegramId автора: при первом входе создаётся пользователь с isAdmin.
# Остальных добавлять командой `bun run user:allow <telegramId>`.
ADMIN_TELEGRAM_ID=

# Только для `vite dev`: открывать Mini App в обычном браузере без Telegram
# от имени этого telegramId (пользователь должен быть в allowlist).
DEV_TELEGRAM_ID=
