{
	"name": "tg-assistant-bot",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"tests"
	],
	"scripts": {
		"dev:web": "bun --filter @tgab/web dev",
		"dev:bot": "bun --filter @tgab/bot dev",
		"build:web": "bun --filter @tgab/web build",
		"check": "bun --filter '*' check",
		"test:unit": "bun tests/run.ts unit",
		"test:integration": "bun tests/run.ts integration",
		"db:generate": "bun --filter @tgab/db generate",
		"db:migrate": "bun --filter @tgab/db migrate:dev",
		"db:deploy": "bun --filter @tgab/db migrate:deploy",
		"db:studio": "bun --filter @tgab/db studio",
		"user:allow": "bun --env-file=.env packages/core/scripts/allow-user.ts",
		"postinstall": "bun --filter @tgab/db generate",
		"lint": "biome check . && prettier --check \"**/*.svelte\"",
		"format": "biome check --write . && prettier --write \"**/*.svelte\""
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"trailingComma": "all",
		"printWidth": 100,
		"plugins": [
			"@ianvs/prettier-plugin-sort-imports",
			"prettier-plugin-svelte",
			"prettier-plugin-tailwindcss"
		],
		"importOrder": [
			"<BUILTIN_MODULES>",
			"<THIRD_PARTY_MODULES>",
			"^#",
			"^[.]"
		],
		"importOrderTypeScriptVersion": "5.0.0",
		"overrides": [
			{
				"files": "*.svelte",
				"options": {
					"parser": "svelte"
				}
			}
		],
		"tailwindFunctions": [
			"mergeClasses"
		],
		"tailwindStylesheet": "./apps/web/src/app.css"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1"
	}
}
