generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Пользователь. Наличие записи = доступ разрешён (allowlist).
model User {
  id         String   @id @default(uuid(7)) @db.Uuid
  telegramId BigInt   @unique
  firstName  String?
  username   String?
  /// IANA-зона, в ней вычисляются повторы напоминаний. Значение по умолчанию — `DEFAULT_TIMEZONE`
  /// в packages/core (constants/users.ts): его подставляет сервис при создании, в БД default нет.
  timezone   String
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  notes                Note[]
  counters             Counter[]
  counterNotifications CounterNotification[]
}

model Note {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  title     String
  content   String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// В БД это GENERATED ALWAYS AS (...) STORED — задано в миграции вручную.
  /// dbgenerated() повторяет выражение так, как его видит Prisma, чтобы migrate не находил расхождений.
  search Unsupported("tsvector")? @default(dbgenerated("to_tsvector('russian'::regconfig, title)"))

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@index([search], type: Gin)
}

/// Режим таймера счётчика: на срок (длительность от старта) или до даты.
enum CounterTimerMode {
  DURATION
  DATE
}

/// Состояние таймера: цикл идёт, стоит на паузе или закончился и ждёт «Старт».
enum CounterTimerStatus {
  RUNNING
  PAUSED
  FINISHED
}

/// Счётчик: число (ручное управление и/или +1 за каждый цикл таймера) и необязательный таймер.
/// Без таймера (`timerMode` = null) счётчик всегда ручной — это проверяет схема в core.
model Counter {
  id              String              @id @default(uuid(7)) @db.Uuid
  userId          String              @db.Uuid
  title           String
  /// Число: меняется вручную (−1, +1, сброс) и растёт на 1 с каждым завершённым циклом.
  value           Int
  /// Показывать кнопки ручного управления (− число +, «Сбросить»).
  manual          Boolean
  /// Показывать число на экране счётчика; при `manual` показывается всегда.
  showValue       Boolean
  timerMode       CounterTimerMode?
  /// Срок цикла (режим DURATION), складывается в часовом поясе пользователя.
  durationMonths  Int
  durationWeeks   Int
  durationDays    Int
  durationHours   Int
  durationMinutes Int
  /// Начало и конец текущего цикла (UTC); null — таймера нет.
  startAt         DateTime?           @db.Timestamptz(3)
  targetAt        DateTime?           @db.Timestamptz(3)
  timerStatus     CounterTimerStatus?
  /// Когда таймер поставлен на паузу (статус PAUSED); «Старт» на срок сдвигает цикл на длину паузы.
  pausedAt        DateTime?           @db.Timestamptz(3)
  /// Старт цикла «на срок» задан вручную; false — старт в момент сохранения настроек.
  customStart     Boolean             @default(false)
  /// Скрыть кнопки «Старт» и «Стоп» (у таймера на паузе «Старт» видна всегда).
  startStopHidden Boolean             @default(false)
  /// Когда закончился последний цикл.
  finishedAt      DateTime?           @db.Timestamptz(3)
  /// Следующий цикл — с теми же параметрами (той же длины), без выбора новой даты.
  repeatSame      Boolean
  /// Следующий цикл начинается сам в момент окончания (только вместе с `repeatSame`).
  autoRestart     Boolean
  /// Уведомлять об окончании цикла (бот и раздел «Напоминания»).
  notify          Boolean
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications CounterNotification[]

  @@index([userId, createdAt(sort: Desc)])
  /// Выборка наступивших циклов воркером.
  @@index([timerStatus, targetAt])
}

/// Уведомление об окончании цикла счётчика (раздел «Напоминания» Mini App и сообщение в боте).
model CounterNotification {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  counterId        String    @db.Uuid
  /// Число счётчика после этого цикла.
  cycle            Int
  /// Конец цикла, о котором уведомление.
  finishedAt       DateTime  @db.Timestamptz(3)
  readAt           DateTime? @db.Timestamptz(3)
  /// Сообщение в Telegram отправлено. null — ещё нет: воркер досылает такие (outbox).
  sentAt           DateTime? @db.Timestamptz(3)
  /// Сообщение не доставить никогда (пользователь заблокировал бота, 403): больше не досылать.
  deliveryFailedAt DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  counter Counter @relation(fields: [counterId], references: [id], onDelete: Cascade)

  /// Один цикл — одно уведомление, даже если воркер обработает его повторно.
  @@unique([counterId, finishedAt])
  @@index([userId, createdAt(sort: Desc)])
  /// Выборка неотправленных воркером.
  @@index([sentAt, createdAt])
}
